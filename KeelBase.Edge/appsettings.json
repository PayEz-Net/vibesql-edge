{
  "ConnectionStrings": {
    "EdgeDb": "Host=localhost;Port=5432;Database=vibe_edge;Username=edge;Password=changeme"
  },
  "VibeEdge": {
    "PublicApiUrl": "http://localhost:5000",
    "RefreshIntervalMinutes": 30,
    "SigningKeyCacheTtlMinutes": 5,
    "ProxyViaHeader": "idp-proxy",
    "BootstrapProviders": []
  },
  "VibeSQL": {
    "UpstreamAuthMode": "hmac",
    "ContainerSecret": "",
    "HmacSecret": ""
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5100"
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "KeelEdge": {
    "TierLimits": {
      "ApiCallsPerDay": 10000,
      "DocumentReadsPerDay": 20000,
      "DocumentWritesPerDay": 2000,
      "SchemaOpsPerDay": 200,
      "BatchOpsPerDay": 100
    }
  },
  "AllowedHosts": "*"
}
